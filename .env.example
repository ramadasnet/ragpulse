# --- Infisical (optional) ---------------------------------------------------
# Load the remaining variables from Infisical at startup (Universal Auth machine identity).
# Variables that already have a value here keep it; empty ones are filled from Infisical.
# RAGPULSE_INFISICAL_CLIENT_ID=
# RAGPULSE_INFISICAL_CLIENT_SECRET=
# RAGPULSE_INFISICAL_PROJECT_ID=
# RAGPULSE_INFISICAL_ENVIRONMENT=prod
# RAGPULSE_INFISICAL_SECRET_PATH=/
# RAGPULSE_INFISICAL_SITE_URL=https://app.infisical.com

# --- Core -------------------------------------------------------------------
# Public URLs of the admin and chat instances, e.g. https://admin.ragpulse.example.com and https://chat.ragpulse.example.com
# Admin: OAuth redirects, MCP endpoint, links in support emails. Chat: embed snippets, chat links, origin checks.
# Leave empty for `bun run dev` (all apps on one origin). docker-compose defaults to http://localhost:3000 and :3001.
# The separate dev instances (dev:admin / dev:chat, ports 3030 / 3031) set these to the dev ports automatically.
NUXT_PUBLIC_ADMIN_URL=
NUXT_PUBLIC_CHAT_URL=
# Project id of the live chat embedded on the landing page (build-time only, empty = no embed)
# NUXT_PUBLIC_CHAT_PROJECT=
# 32+ random characters, used to seal the admin session cookie and hash visitor IPs (openssl rand -base64 32)
NUXT_APP_SECRET=change-me-to-a-long-random-string-of-32-chars-min
# Emails that become admins on their first social login (comma separated)
NUXT_ADMIN_EMAILS=you@example.com

# --- MongoDB ----------------------------------------------------------------
# Use MongoDB Atlas, the mongodb/mongodb-atlas-local image (docker-compose) or Community 8.2+ with mongot
# for native $vectorSearch. A plain mongod also works (in-app similarity fallback, fine for small knowledge bases).
NUXT_MONGODB_URI=mongodb://127.0.0.1:27017/ragpulse?directConnection=true

# --- AI provider ------------------------------------------------------------
# OpenRouter is the default; a custom OpenAI-compatible endpoint can be set on the admin
# Global Settings page instead (saved values override these). The OpenRouter key can be
# edited there too.
NUXT_OPENROUTER_API_KEY=
# Custom OpenAI-compatible provider for chat and embeddings instead of OpenRouter
# NUXT_CUSTOM_AI_PROVIDER=false
# NUXT_AI_PROVIDER_BASE_URL=https://api.openai.com/v1
# NUXT_AI_PROVIDER_API_KEY=
# Default chat model — must be an id the configured provider exposes (a custom endpoint will reject OpenRouter ids like openrouter/free)
NUXT_DEFAULT_CHAT_MODEL=openrouter/free
# Default embedding model. Change it on the admin Settings page instead: all stored knowledge is then re-embedded
# in the background and the vector index is updated automatically (settings saved there override these values)
NUXT_EMBEDDING_MODEL=openai/text-embedding-3-small
NUXT_EMBEDDING_DIMENSIONS=1536
# Vision model that reads images and scanned PDFs (empty disables them). PDFs with a text layer are always read locally.
NUXT_VISION_MODEL=openrouter/free
# Max images / scanned PDFs sent to the vision model per source sync (results are cached, the rest continues next sync)
NUXT_VISION_MAX_PER_SYNC=100
# Chat model retried once when a request to the project's model fails (empty = no fallback). Overridden by the admin Settings page.
NUXT_FALLBACK_MODEL=
# Model that summarizes the source code of git repositories and writes an overview of how the application works
# (empty disables summaries, code is then indexed as is). Overridden by the admin Settings page.
NUXT_CODE_SUMMARY_MODEL=openrouter/free
# Max new code files summarized per source sync (results are cached, the rest continues within an hour)
NUXT_CODE_SUMMARY_MAX_PER_SYNC=500

# --- Google Drive sources ---------------------------------------------------
# Index Google Drive folders: create a service account in Google Cloud, enable the Google Drive API,
# create a JSON key for it and paste the key here as single-line JSON or base64-encoded. Share each
# folder with the key's client_email as Viewer. A different key can be pasted per source in the UI.
# NUXT_GOOGLE_SERVICE_ACCOUNT_KEY=

# --- Social login (at least one) --------------------------------------------
# Google: redirect URI = {ADMIN_URL}/auth/google
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
# Microsoft (Entra ID): redirect URI = {ADMIN_URL}/auth/microsoft
NUXT_OAUTH_MICROSOFT_CLIENT_ID=
NUXT_OAUTH_MICROSOFT_CLIENT_SECRET=
NUXT_OAUTH_MICROSOFT_TENANT=common

# --- Email (support escalations, replies to visitors, invites) ---------------
# Cloudflare Email Service is the default: set the password to an API token with the "Email Sending: Edit" permission
# and the sender to an address on a domain onboarded for Email Sending. Override host, port and user for another server.
# NUXT_SMTP_HOST=smtp.mx.cloudflare.net
# NUXT_SMTP_PORT=465
# Implicit TLS on port 465, STARTTLS on other ports; set to true/false to override
# NUXT_SMTP_SECURE=
# NUXT_SMTP_USER=api_token
NUXT_SMTP_PASS=
NUXT_SMTP_FROM="RAGPulse <support@example.com>"

# --- Logging ----------------------------------------------------------------
# Minimum log level: debug, info, warn or error (default info)
# RAGPULSE_LOG_LEVEL=info
# One JSON line per log entry for log collectors (default: enabled in production, disabled in development)
# RAGPULSE_LOG_JSON=

# --- Misc -------------------------------------------------------------------
# Website crawler User-Agent (empty = RAGPulseBot/1.0 (+chat URL)) and minimum delay between two requests to the
# same site in milliseconds. Both can be changed on the admin Settings page. 429 responses are retried after Retry-After.
# NUXT_CRAWLER_USER_AGENT=
# NUXT_CRAWLER_REQUEST_INTERVAL_MS=500
# Set to true to allow source/branding/AI-provider/webhook URLs pointing at private or internal addresses (intranet
# installs, local inference like Ollama). Keep unset otherwise so indexing can't reach the internal network.
# RAGPULSE_ALLOW_PRIVATE_URLS=
# Seconds between scheduler ticks (checks for sources due for refresh)
NUXT_SYNC_TICK_SECONDS=60
# Days without activity after which chat sessions (with their messages and questions) are deleted, 0 keeps them forever
NUXT_CHAT_SESSION_RETENTION_DAYS=180
# Days sync runs are kept in each source's history (1..365), can be changed on the admin Settings page
# NUXT_SYNC_HISTORY_DAYS=30
# Minutes to wait before emailing an answer to a visitor who is not in the chat (0..1440, 0 = right away), can be changed on the admin Settings page
# NUXT_ANSWER_EMAIL_DELAY_MINUTES=10
# Minutes an escalated chat waits for a human to take over before telling the visitor the answer comes by email (0..1440, 0 = right away), can be changed on the admin Settings page
# NUXT_HUMAN_TAKEOVER_WAIT_MINUTES=5
# Development only: enables /auth/dev?email=... login shortcut in `bun run dev`
NUXT_DEV_LOGIN=false
