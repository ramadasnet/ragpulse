{
    "name": "ragpulse",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "bun --preload ./server/preload.ts ./node_modules/.bin/nuxt dev",
        "dev:admin": "RAGPULSE_APP=admin RAGPULSE_BUILD_DIR=.nuxt/admin NUXT_PUBLIC_ADMIN_URL=http://localhost:3030 NUXT_PUBLIC_CHAT_URL=http://localhost:3031 bun --preload ./server/preload.ts ./node_modules/.bin/nuxt dev --port 3030",
        "dev:chat": "RAGPULSE_APP=chat RAGPULSE_BUILD_DIR=.nuxt/chat NUXT_PUBLIC_ADMIN_URL=http://localhost:3030 NUXT_PUBLIC_CHAT_URL=http://localhost:3031 bun --preload ./server/preload.ts ./node_modules/.bin/nuxt dev --port 3031",
        "dev:landing": "RAGPULSE_APP=landing RAGPULSE_BUILD_DIR=.nuxt/landing NUXT_PUBLIC_CHAT_URL=http://localhost:3031 bun --preload ./server/preload.ts ./node_modules/.bin/nuxt dev --port 3032",
        "build": "bun --bun nuxt build",
        "build:admin": "RAGPULSE_APP=admin bun --bun nuxt build",
        "build:chat": "RAGPULSE_APP=chat bun --bun nuxt build",
        "build:landing": "RAGPULSE_APP=landing bun --bun nuxt generate",
        "start": "bun --preload ./server/preload.ts .output/server/index.mjs",
        "preview": "bun --bun nuxt preview",
        "typecheck": "nuxt prepare && vue-tsc --noEmit -p .nuxt/tsconfig.server.json && vue-tsc --noEmit -p .nuxt/tsconfig.app.json",
        "check": "bun run typecheck && bun test",
        "test": "bun test",
        "format": "prettier --write \"{app,server,shared,tests,landing}/**/*.{ts,vue,json,css,md}\" \"*.{ts,json,md}\"",
        "format:check": "prettier --check \"{app,server,shared,tests,landing}/**/*.{ts,vue,json,css,md}\" \"*.{ts,json,md}\"",
        "postinstall": "nuxt prepare"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.32.2",
        "@mozilla/readability": "^0.6.0",
        "anyhow": "^4.0.0",
        "dompurify": "^3.4.18",
        "fflate": "^0.8.3",
        "linkedom": "^0.18.15",
        "lucide-vue-next": "^1.0.0",
        "marked": "^18.2.0",
        "mongodb": "^7.9.0",
        "nodemailer": "^10.5.0",
        "nuxt": "^4.6.4",
        "nuxt-auth-utils": "^0.6.2",
        "turndown": "^7.2.5",
        "unpdf": "^2.2.1",
        "vue": "^3.5.45",
        "vue-router": "^5.5.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/bun": "^1.4.4",
        "@types/dompurify": "^3.0.5",
        "@types/nodemailer": "^8.0.2",
        "@types/turndown": "^5.0.6",
        "prettier": "^3.10.1",
        "typescript": "^6.0.3",
        "vue-tsc": "^3.3.14"
    },
    "prettier": {
        "trailingComma": "none",
        "tabWidth": 4,
        "semi": false,
        "singleQuote": false,
        "arrowParens": "always",
        "bracketSpacing": false,
        "printWidth": 250
    },
    "version": "26.467.12333"
}
